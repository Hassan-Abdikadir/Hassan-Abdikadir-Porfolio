# ============================================
# SERVER ENVIRONMENT VARIABLES
# Copy this file → rename to .env
# Fill in real values before running
# ============================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/MyPortfolio?retryWrites=true&w=majority

# JWT Secret — use a long random string (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Frontend URL (your Vercel URL after deployment)
CLIENT_URL=https://your-portfolio.vercel.app

# Email (Nodemailer — for contact form)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
